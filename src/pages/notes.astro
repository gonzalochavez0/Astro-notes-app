---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Mis notas — Notas"
  description="Editor de notas con autoguardado, búsqueda y sesión protegida."
  bodyClass="bg-[#f5f1e8]"
>
  <div class="flex min-h-screen flex-col md:h-screen md:overflow-hidden">
    <!-- HEADER -->
    <header
      class="flex h-14 shrink-0 items-center justify-between border-b bg-[#efe9dc] px-4 md:px-6"
    >
      <div class="flex w-24 items-center gap-2" aria-hidden="true">
        <span class="h-3 w-3 rounded-full bg-red-400"></span>
        <span class="h-3 w-3 rounded-full bg-yellow-400"></span>
        <span class="h-3 w-3 rounded-full bg-green-400"></span>
      </div>

      <div class="text-center leading-tight">
        <p class="font-semibold">Notas</p>
        <p id="username" class="text-xs text-gray-500"></p>
      </div>

      <div class="flex w-24 items-center justify-end gap-3">
        <button
          id="newNoteBtn"
          type="button"
          aria-label="Nueva nota"
          class="flex h-8 w-8 items-center justify-center rounded-full border bg-white text-lg leading-none transition hover:bg-gray-100"
        >
          +
        </button>
        <button id="logoutBtn" type="button" class="text-sm text-gray-600 hover:underline">
          Salir
        </button>
      </div>
    </header>

    <!-- MAIN -->
    <div class="flex min-h-0 flex-1 flex-col md:flex-row">
      <!-- SIDEBAR -->
      <aside
        class="w-full shrink-0 border-b bg-[#efe9dc]/40 p-4 md:w-1/3 md:max-w-sm md:border-r md:border-b-0 md:overflow-y-auto md:p-6"
      >
        <label class="sr-only" for="searchInput">Buscar notas</label>
        <input
          id="searchInput"
          type="search"
          placeholder="Buscar notas..."
          class="mb-4 w-full rounded-lg border bg-white px-3 py-2 outline-none focus:ring-2 focus:ring-purple-300"
        />

        <div id="notesList" class="space-y-3"></div>

        <p id="emptyState" class="hidden p-4 text-center text-sm text-gray-500">
          Todavía no tienes notas. Crea la primera con el botón <strong>+</strong>.
        </p>
      </aside>

      <!-- EDITOR -->
      <section class="flex min-h-0 flex-1 flex-col p-6 md:p-8">
        <div class="mb-4 flex items-center gap-3">
          <label class="sr-only" for="titleInput">Título de la nota</label>
          <input
            id="titleInput"
            placeholder="Nueva nota"
            class="w-full bg-transparent text-2xl font-semibold outline-none"
          />

          <button
            id="deleteBtn"
            type="button"
            disabled
            class="shrink-0 rounded-lg border px-3 py-1 text-red-500 transition hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent"
          >
            Eliminar
          </button>
        </div>

        <label class="sr-only" for="contentInput">Contenido de la nota</label>
        <textarea
          id="contentInput"
          placeholder="Escribe algo..."
          class="min-h-[40vh] w-full flex-1 resize-none bg-transparent outline-none"
        ></textarea>

        <p id="status" class="mt-2 text-xs text-gray-400" role="status" aria-live="polite"></p>
      </section>
    </div>
  </div>
</Layout>

<script>
  import { supabase, notifyMissingConfig } from "../lib/supabase";

  /** Notes with an explicit timezone are parsed as-is; naive timestamps are UTC. */
  function parseDate(value) {
    if (!value) return null;
    const hasTimeZone = /([zZ]|[+-]\d{2}:?\d{2})$/.test(value);
    const date = new Date(hasTimeZone ? value : `${value}Z`);
    return Number.isNaN(date.getTime()) ? null : date;
  }

  function timeAgo(value) {
    const date = parseDate(value);
    if (!date) return "";

    const now = new Date();
    const isToday = date.toDateString() === now.toDateString();

    const yesterday = new Date();
    yesterday.setDate(now.getDate() - 1);
    const isYesterday = date.toDateString() === yesterday.toDateString();

    const time = date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });

    if (isToday) return time;
    if (isYesterday) return `Ayer ${time}`;

    return `${date.toLocaleDateString([], { day: "numeric", month: "short" })} ${time}`;
  }

  async function main() {
    if (!supabase) {
      notifyMissingConfig();
      return;
    }

    const {
      data: { user },
    } = await supabase.auth.getUser();

    // The login form lives on the landing page as a modal.
    if (!user) {
      window.location.replace("/");
      return;
    }

    // -------- elements --------
    const usernameEl = document.getElementById("username");
    const notesList = document.getElementById("notesList");
    const emptyState = document.getElementById("emptyState");
    const titleInput = document.getElementById("titleInput");
    const contentInput = document.getElementById("contentInput");
    const newNoteBtn = document.getElementById("newNoteBtn");
    const deleteBtn = document.getElementById("deleteBtn");
    const logoutBtn = document.getElementById("logoutBtn");
    const statusEl = document.getElementById("status");
    const searchInput = document.getElementById("searchInput");

    usernameEl.textContent = user.email ?? "";

    // -------- state --------
    let notes = [];
    let selectedNoteId = null;
    let saveTimer = null;

    const setStatus = (message) => {
      statusEl.textContent = message;
    };

    // -------- rendering --------
    function renderSidebar(list = notes) {
      notesList.innerHTML = "";

      emptyState.classList.toggle("hidden", list.length > 0);
      emptyState.textContent = searchInput.value.trim()
        ? "No hay notas que coincidan con tu búsqueda."
        : "Todavía no tienes notas. Crea la primera con el botón +.";

      for (const note of list) {
        const card = document.createElement("div");
        card.className =
          "block w-full text-left rounded-xl p-4 shadow transition cursor-pointer " +
          (note.id === selectedNoteId ? "bg-yellow-200" : "bg-white hover:bg-yellow-100");
        card.setAttribute("role", "button");
        card.setAttribute("tabindex", "0");
        card.setAttribute("aria-current", note.id === selectedNoteId ? "true" : "false");

        const title = document.createElement("h3");
        title.className = "font-semibold truncate";
        title.textContent = note.title || "Sin título";

        const preview = document.createElement("p");
        preview.className = "text-sm text-gray-600 line-clamp-2";
        preview.textContent = note.content || "Sin contenido";

        const time = document.createElement("p");
        time.className = "text-xs text-gray-400 mt-1";
        time.textContent = timeAgo(note.created_at);

        card.append(title, preview, time);
        card.addEventListener("click", () => openNote(note.id));
        card.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            openNote(note.id);
          }
        });

        notesList.appendChild(card);
      }
    }

    function openNote(id) {
      const note = notes.find((item) => item.id === id);
      if (!note) return;

      selectedNoteId = id;
      titleInput.value = note.title ?? "";
      contentInput.value = note.content ?? "";
      deleteBtn.disabled = false;
      setStatus("Editando");

      renderSidebar();
    }

    function resetEditor() {
      selectedNoteId = null;
      titleInput.value = "";
      contentInput.value = "";
      deleteBtn.disabled = true;
      setStatus("");
    }

    // -------- data --------
    async function loadNotes({ keepSelection = false } = {}) {
      const { data, error } = await supabase
        .from("notes")
        .select("*")
        .order("created_at", { ascending: false });

      if (error) {
        console.error(error);
        setStatus(`No se pudieron cargar las notas: ${error.message}`);
        return;
      }

      notes = data ?? [];
      renderSidebar();

      if (keepSelection && notes.some((note) => note.id === selectedNoteId)) {
        return;
      }

      if (notes.length > 0) {
        openNote(notes[0].id);
      } else {
        resetEditor();
        setStatus("No hay notas aún");
      }
    }

    // -------- creating --------
    newNoteBtn.addEventListener("click", async () => {
      const { data, error } = await supabase
        .from("notes")
        .insert({ title: "Nueva nota", content: "", user_id: user.id })
        .select()
        .single();

      if (error) {
        setStatus(`No se pudo crear la nota: ${error.message}`);
        return;
      }

      notes.unshift(data);
      openNote(data.id);
      titleInput.focus();
      titleInput.select();
      setStatus("Nota creada");
    });

    // -------- deleting --------
    deleteBtn.addEventListener("click", async () => {
      if (!selectedNoteId) return;
      if (!confirm("¿Eliminar esta nota?")) return;

      const { error } = await supabase.from("notes").delete().eq("id", selectedNoteId);

      if (error) {
        setStatus(`No se pudo eliminar: ${error.message}`);
        return;
      }

      notes = notes.filter((note) => note.id !== selectedNoteId);
      resetEditor();
      await loadNotes();
      setStatus("Nota eliminada");
    });

    // -------- searching --------
    searchInput.addEventListener("input", () => {
      const query = searchInput.value.trim().toLowerCase();

      const filtered = query
        ? notes.filter(
            (note) =>
              note.title?.toLowerCase().includes(query) ||
              note.content?.toLowerCase().includes(query),
          )
        : notes;

      renderSidebar(filtered);
    });

    // -------- autosave --------
    function scheduleSave() {
      if (!selectedNoteId) return;

      clearTimeout(saveTimer);
      saveTimer = setTimeout(async () => {
        const noteId = selectedNoteId;
        const title = titleInput.value;
        const content = contentInput.value;

        setStatus("Guardando…");

        const { error } = await supabase
          .from("notes")
          .update({ title, content })
          .eq("id", noteId);

        if (error) {
          console.error(error);
          setStatus(`Error al guardar: ${error.message}`);
          return;
        }

        const index = notes.findIndex((note) => note.id === noteId);
        if (index !== -1) {
          notes[index] = { ...notes[index], title, content };
        }

        renderSidebar();
        setStatus("Guardado ✓");
      }, 600);
    }

    titleInput.addEventListener("input", scheduleSave);
    contentInput.addEventListener("input", scheduleSave);

    // -------- session --------
    logoutBtn.addEventListener("click", async () => {
      await supabase.auth.signOut();
      window.location.replace("/");
    });

    await loadNotes();
  }

  main();
</script>
